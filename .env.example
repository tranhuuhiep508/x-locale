# Copy this file to .env and edit as needed.
# Used by the backend (Pydantic Settings), frontend (Vite), and Docker Compose.

# Postgres is required. Start it with: docker compose up -d postgres
# Tests refuse to run when TEST_DATABASE_URL equals DATABASE_URL.
# TEST_DATABASE_URL is the bootstrap database. Harnesses connect to it, not to
# the postgres database, when they CREATE and DROP their own databases. The role
# needs CREATEDB and CONNECT on this database.
DATABASE_URL=postgresql+psycopg://xlocale:xlocale@localhost:5432/xlocale
TEST_DATABASE_URL=postgresql+psycopg://xlocale:xlocale@localhost:5432/xlocale_test

# AI translation does not read AWS credentials.
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# AI translation: OpenAI Responses API with strict structured output.
# Empty base URL uses the SDK's normal OpenAI endpoint; gateways need Responses support.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=
OPENAI_MAX_OUTPUT_TOKENS=16000
AI_TRANSLATE_BATCH_SIZE=20
AI_TRANSLATE_MAX_WORKERS=5
# AI_TRANSLATE_STUB=true  # deterministic local/E2E translations without credentials
# Timeouts inherit SDK defaults; retries and gap filling extend total job duration.

# App secrets
X_LOCALE_SECRET=change-me
X_LOCALE_DEMO_API_KEY=demo-local-key
DEFAULT_BASE_LANGUAGE=vi

# ENV=production makes seed-demo refuse unless --allow-production is passed.
# Leave ENV unset on a fresh clone so seed-demo can run.

# Auth — Microsoft Entra ID (work + personal accounts).
# For local dev with no OIDC, set AUTH_DEV_BYPASS=true in your .env.
# When OIDC_* is filled, bypass is ignored even if AUTH_DEV_BYPASS=true.
AUTH_DEV_BYPASS=false
OIDC_ISSUER=https://login.microsoftonline.com/common/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES="openid email profile" # pragma: allowlist secret
OIDC_REDIRECT_URL=http://localhost:5173/api/auth/callback

# Delete activity rows older than N days (0 = keep forever). Default 90.
# Pruning drops old feed/History/Undo events; it does not delete strings.
# Run `uv run python -m app.cli prune-activities` on a schedule (not on API boot).
ACTIVITY_RETENTION_DAYS=90

# Frontend (Vite)
# Dev proxy target when running backend separately (default: http://127.0.0.1:8000)
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional: only when frontend runs on a different origin than the API.
# CORS_ORIGINS=http://localhost:5173

# Production: built frontend is served by FastAPI (see docker-compose.prod.yml).
# STATIC_DIR=static
