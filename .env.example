# Copy this file to .env and edit as needed.
# Used by the backend (Pydantic Settings), frontend (Vite), and Docker Compose.

# Database (default: SQLite in backend/)
DATABASE_URL=sqlite:///./tms.db
# Postgres example (start with: docker compose up postgres -d):
# DATABASE_URL=postgresql+psycopg://tms:tms@localhost:5432/tms

# AWS Bedrock (optional — for AI translate)
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key
# Nova models require an inference profile ID (not the base model ID).
# US: us.amazon.nova-2-lite-v1:0 | EU: eu.amazon.nova-2-lite-v1:0 | Global: global.amazon.nova-2-lite-v1:0
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0

# App secrets
TMS_SECRET=dev-secret-change-me
TMS_DEMO_API_KEY=demo-api-key-change-me
DEFAULT_BASE_LANGUAGE=vi

# Auth — set AUTH_DEV_BYPASS=true for local UI without an IdP (default).
# For real OIDC, set AUTH_DEV_BYPASS=false and fill the OIDC_* vars.
AUTH_DEV_BYPASS=true
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
OIDC_REDIRECT_URL=http://localhost:8000/api/auth/callback

# Optional: prune append-only activity log (0 = keep forever)
ACTIVITY_RETENTION_DAYS=0

# Frontend (Vite)
# Dev proxy target when running backend separately (default: http://127.0.0.1:8000)
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional: only when frontend runs on a different origin than the API.
# CORS_ORIGINS=http://localhost:5173

# Production: built frontend is served by FastAPI (see docker-compose.prod.yml).
# STATIC_DIR=static
