# Copy this file to .env and edit as needed.
# Used by the backend (Pydantic Settings), frontend (Vite), and Docker Compose.

# Database (default: SQLite in backend/)
DATABASE_URL=sqlite:///./x-locale.db
# Postgres example (start with: docker compose up postgres -d):
# DATABASE_URL=postgresql+psycopg://xlocale:xlocale@localhost:5432/xlocale

# AWS Bedrock (optional — for AI translate)
AWS_REGION=us-east-1
# Preferred: IAM credentials. Before each Bedrock request the backend calls
# provide_token() to mint (or reuse a cached) short-term API key.
# Must be real process env vars (export or Docker Compose); boto3 does not
# read them from Pydantic .env loading.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=   # only for temporary/SSO credentials
#
# Optional fallback: static long-term Bedrock API key if IAM is not available.
# Leave unset when using IAM so an expired key cannot shadow credentials.
# AWS_BEARER_TOKEN_BEDROCK=
# Nova models require an inference profile ID (not the base model ID).
# US: us.amazon.nova-2-lite-v1:0 | EU: eu.amazon.nova-2-lite-v1:0 | Global: global.amazon.nova-2-lite-v1:0
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0

# App secrets
X_LOCALE_SECRET=change-me
X_LOCALE_DEMO_API_KEY=demo-local-key
DEFAULT_BASE_LANGUAGE=vi

# Auth — Microsoft Entra ID (work + personal accounts).
# Set AUTH_DEV_BYPASS=true to skip SSO and mint a local Dev User (no IdP).
# When OIDC_* is filled, bypass is ignored even if AUTH_DEV_BYPASS=true.
AUTH_DEV_BYPASS=false
OIDC_ISSUER=https://login.microsoftonline.com/common/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
OIDC_REDIRECT_URL=http://localhost:5173/api/auth/callback

# Delete activity rows older than N days (0 = keep forever). Default 90.
# Pruning drops old feed/History/Undo events; it does not delete strings.
# Run `uv run python -m app.cli prune-activities` on a schedule (not on API boot).
ACTIVITY_RETENTION_DAYS=90

# Frontend (Vite)
# Dev proxy target when running backend separately (default: http://127.0.0.1:8000)
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional: only when frontend runs on a different origin than the API.
# CORS_ORIGINS=http://localhost:5173

# Production: built frontend is served by FastAPI (see docker-compose.prod.yml).
# STATIC_DIR=static
